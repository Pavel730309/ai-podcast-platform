# ============================================================
# AI Podcast Platform — Environment Variables
# Скопируйте этот файл в .env и заполните значения
# cp .env.example .env
# ============================================================

# ---- База данных PostgreSQL ----
POSTGRES_DB=podcast_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ---- Безопасность ----
# Генерация: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_GENERATE_STRONG_SECRET_KEY

# ---- AI провайдеры ----
# OpenAI (обязательно для генерации сценариев и TTS)
OPENAI_API_KEY=sk-...

# ElevenLabs (опционально, для более качественного TTS)
ELEVENLABS_API_KEY=

# KIE.ai (опционально, альтернативный провайдер)
KIE_API_KEY=

# ---- Фронтенд ----
# URL бэкенда для фронтенда (используется при сборке Docker образа)
# Для VPS: http://YOUR_SERVER_IP или https://your-domain.com
VITE_API_URL=http://localhost

# ---- CORS ----
# Список разрешённых origins для API (JSON массив)
# Для production замените на реальный домен
CORS_ORIGINS=["http://localhost", "http://localhost:3000"]

# ---- Настройки приложения ----
DEBUG=false
APP_NAME=AI Podcast Platform
APP_VERSION=1.0.0
